{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "item.schema.json",
  "title": "Content record: one page (spec §5)",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "#/$defs/page_id"
    },
    "plain_name": {
      "type": "string",
      "minLength": 1
    },
    "code_name": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "stage": {
      "enum": [
        "explore",
        "clean",
        "transform",
        "select",
        "split",
        "model",
        "tune",
        "evaluate",
        "interpret"
      ]
    },
    "family": {
      "type": "string",
      "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+$"
    },
    "tracks": {
      "type": "array",
      "items": {
        "enum": [
          "standard",
          "time-series",
          "unsupervised",
          "causal",
          "deep-learning"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "archetype": {
      "enum": [
        "transformer",
        "resampler",
        "selector",
        "splitter",
        "model",
        "hyperparameter",
        "tuning",
        "metric",
        "diagnostic",
        "output",
        "composer"
      ]
    },
    "question_tags": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/tag"
      },
      "uniqueItems": true
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "applies_to": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/page_id"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "pairs_with": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/page_id"
      },
      "uniqueItems": true
    },
    "clashes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/page_id"
      },
      "uniqueItems": true
    },
    "source_urls": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri",
        "pattern": "^https?://"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "library_versions": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "enum": [
          "scikit-learn",
          "statsmodels",
          "scipy",
          "xgboost",
          "lightgbm",
          "imbalanced-learn",
          "optuna",
          "shap",
          "matplotlib"
        ]
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9]+(\\.[0-9]+)*$"
      }
    },
    "reviewed": {
      "type": "boolean"
    },
    "rules": {
      "type": "object",
      "properties": {
        "task_types": {
          "type": "array",
          "items": {
            "enum": [
              "regression",
              "classification"
            ]
          },
          "uniqueItems": true
        },
        "blocked_when": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "when": {
                "$ref": "#/$defs/condition"
              },
              "reason": {
                "type": "string",
                "pattern": "^(\\S+\\s+){0,11}\\S+$",
                "maxLength": 120
              }
            },
            "required": [
              "when",
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "fits_on_data": {
          "type": "boolean"
        },
        "shape_effect": {
          "type": "object",
          "properties": {
            "rows": {
              "enum": [
                "same",
                "grows",
                "shrinks",
                "expands"
              ]
            },
            "columns": {
              "enum": [
                "same",
                "grows",
                "shrinks",
                "expands"
              ]
            }
          },
          "required": [
            "rows",
            "columns"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "task_types",
        "blocked_when",
        "fits_on_data",
        "shape_effect"
      ],
      "additionalProperties": false
    },
    "slots": {
      "type": "object",
      "properties": {
        "header": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": false
        },
        "solves": {
          "oneOf": [
            {
              "$ref": "#/$defs/none"
            },
            {
              "type": "object",
              "properties": {
                "hero": {
                  "type": "object"
                },
                "line": {
                  "$ref": "#/$defs/one_line"
                }
              },
              "required": [
                "hero",
                "line"
              ],
              "additionalProperties": false
            }
          ]
        },
        "quick_facts": {
          "oneOf": [
            {
              "$ref": "#/$defs/none"
            },
            {
              "$ref": "#/$defs/toy_facts"
            },
            {
              "$ref": "#/$defs/hp_facts"
            },
            {
              "$ref": "#/$defs/model_facts"
            }
          ]
        },
        "use_avoid": {
          "type": "object",
          "properties": {
            "use_when": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/tag"
              }
            },
            "avoid_when": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/tag"
              }
            }
          },
          "required": [
            "use_when",
            "avoid_when"
          ],
          "additionalProperties": false
        },
        "prep": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/prep_entry"
          }
        },
        "code": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/code_tab"
          }
        },
        "what_comes_out": {
          "oneOf": [
            {
              "$ref": "#/$defs/none"
            },
            {
              "$ref": "#/$defs/what_comes_out_body"
            }
          ]
        },
        "catch_outs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/one_line"
          }
        },
        "key_settings": {
          "type": "object",
          "properties": {
            "tier1": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/setting_ref"
              }
            },
            "tier2": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/setting_ref"
              }
            },
            "tier3": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/setting_ref"
              }
            }
          },
          "required": [
            "tier1",
            "tier2",
            "tier3"
          ],
          "additionalProperties": false
        },
        "watch_it_work": {
          "oneOf": [
            {
              "$ref": "#/$defs/none"
            },
            {
              "type": "object",
              "properties": {
                "dataset": {
                  "$ref": "#/$defs/dataset"
                },
                "control": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "min": {
                      "type": "number"
                    },
                    "max": {
                      "type": "number"
                    },
                    "step": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "default": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "name",
                    "min",
                    "max",
                    "step",
                    "default"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "dataset",
                "control"
              ],
              "additionalProperties": false
            }
          ]
        },
        "intuition": {
          "oneOf": [
            {
              "$ref": "#/$defs/none"
            },
            {
              "$ref": "#/$defs/short_intuition"
            },
            {
              "$ref": "#/$defs/model_intuition"
            }
          ]
        },
        "next": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/page_id"
          },
          "description": "Question ids (content/questions/<stage>.yaml)."
        }
      },
      "required": [
        "header",
        "solves",
        "quick_facts",
        "use_avoid",
        "prep",
        "code",
        "what_comes_out",
        "catch_outs",
        "key_settings",
        "watch_it_work",
        "intuition",
        "next"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "plain_name",
    "code_name",
    "aliases",
    "stage",
    "family",
    "tracks",
    "archetype",
    "question_tags",
    "targets",
    "pairs_with",
    "clashes",
    "source_urls",
    "library_versions",
    "reviewed",
    "rules",
    "slots"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "archetype": {
            "const": "transformer"
          }
        }
      },
      "then": {
        "properties": {
          "slots": {
            "properties": {
              "solves": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/none"
                  },
                  {
                    "required": [
                      "hero"
                    ],
                    "properties": {
                      "hero": {
                        "$ref": "#/$defs/hero_transformer"
                      }
                    }
                  }
                ]
              },
              "quick_facts": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/none"
                  },
                  {
                    "$ref": "#/$defs/toy_facts"
                  }
                ]
              },
              "intuition": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/none"
                  },
                  {
                    "$ref": "#/$defs/short_intuition"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "archetype": {
            "const": "resampler"
          }
        }
      },
      "then": {
        "properties": {
          "slots": {
            "properties": {
              "solves": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/none"
                  },
                  {
                    "required": [
                      "hero"
                    ],
                    "properties": {
                      "hero": {
                        "$ref": "#/$defs/hero_resampler"
                      }
                    }
                  }
                ]
              },
              "quick_facts": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/none"
                  },
                  {
                    "$ref": "#/$defs/toy_facts"
                  }
                ]
              },
              "intuition": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/none"
                  },
                  {
                    "$ref": "#/$defs/short_intuition"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "archetype": {
            "const": "selector"
          }
        }
      },
      "then": {
        "properties": {
          "slots": {
            "properties": {
              "solves": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/none"
                  },
                  {
                    "required": [
                      "hero"
                    ],
                    "properties": {
                      "hero": {
                        "$ref": "#/$defs/hero_selector"
                      }
                    }
                  }
                ]
              },
              "quick_facts": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/none"
                  },
                  {
                    "$ref": "#/$defs/toy_facts"
                  }
                ]
              },
              "intuition": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/none"
                  },
                  {
                    "$ref": "#/$defs/short_intuition"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "archetype": {
            "const": "splitter"
          }
        }
      },
      "then": {
        "properties": {
          "slots": {
            "properties": {
              "solves": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/none"
                  },
                  {
                    "required": [
                      "hero"
                    ],
                    "properties": {
                      "hero": {
                        "$ref": "#/$defs/hero_splitter"
                      }
                    }
                  }
                ]
              },
              "quick_facts": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/none"
                  },
                  {
                    "$ref": "#/$defs/toy_facts"
                  }
                ]
              },
              "intuition": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/none"
                  },
                  {
                    "$ref": "#/$defs/short_intuition"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "archetype": {
            "const": "model"
          }
        }
      },
      "then": {
        "properties": {
          "slots": {
            "properties": {
              "solves": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/none"
                  },
                  {
                    "required": [
                      "hero"
                    ],
                    "properties": {
                      "hero": {
                        "$ref": "#/$defs/hero_model"
                      }
                    }
                  }
                ]
              },
              "quick_facts": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/none"
                  },
                  {
                    "$ref": "#/$defs/model_facts"
                  }
                ]
              },
              "intuition": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/none"
                  },
                  {
                    "$ref": "#/$defs/model_intuition"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "archetype": {
            "const": "hyperparameter"
          }
        }
      },
      "then": {
        "properties": {
          "slots": {
            "properties": {
              "solves": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/none"
                  },
                  {
                    "required": [
                      "hero"
                    ],
                    "properties": {
                      "hero": {
                        "$ref": "#/$defs/hero_hyperparameter"
                      }
                    }
                  }
                ]
              },
              "quick_facts": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/none"
                  },
                  {
                    "$ref": "#/$defs/hp_facts"
                  }
                ]
              },
              "intuition": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/none"
                  },
                  {
                    "$ref": "#/$defs/short_intuition"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "archetype": {
            "const": "tuning"
          }
        }
      },
      "then": {
        "properties": {
          "slots": {
            "properties": {
              "solves": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/none"
                  },
                  {
                    "required": [
                      "hero"
                    ],
                    "properties": {
                      "hero": {
                        "$ref": "#/$defs/hero_tuning"
                      }
                    }
                  }
                ]
              },
              "quick_facts": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/none"
                  },
                  {
                    "$ref": "#/$defs/toy_facts"
                  }
                ]
              },
              "intuition": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/none"
                  },
                  {
                    "$ref": "#/$defs/short_intuition"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "archetype": {
            "const": "metric"
          }
        }
      },
      "then": {
        "properties": {
          "slots": {
            "properties": {
              "solves": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/none"
                  },
                  {
                    "required": [
                      "hero"
                    ],
                    "properties": {
                      "hero": {
                        "$ref": "#/$defs/hero_metric"
                      }
                    }
                  }
                ]
              },
              "quick_facts": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/none"
                  },
                  {
                    "$ref": "#/$defs/toy_facts"
                  }
                ]
              },
              "intuition": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/none"
                  },
                  {
                    "$ref": "#/$defs/short_intuition"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "archetype": {
            "const": "diagnostic"
          }
        }
      },
      "then": {
        "properties": {
          "slots": {
            "properties": {
              "solves": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/none"
                  },
                  {
                    "required": [
                      "hero"
                    ],
                    "properties": {
                      "hero": {
                        "$ref": "#/$defs/hero_diagnostic"
                      }
                    }
                  }
                ]
              },
              "quick_facts": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/none"
                  },
                  {
                    "$ref": "#/$defs/toy_facts"
                  }
                ]
              },
              "intuition": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/none"
                  },
                  {
                    "$ref": "#/$defs/short_intuition"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "archetype": {
            "const": "output"
          }
        }
      },
      "then": {
        "properties": {
          "slots": {
            "properties": {
              "solves": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/none"
                  },
                  {
                    "required": [
                      "hero"
                    ],
                    "properties": {
                      "hero": {
                        "$ref": "#/$defs/hero_output"
                      }
                    }
                  }
                ]
              },
              "quick_facts": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/none"
                  },
                  {
                    "$ref": "#/$defs/toy_facts"
                  }
                ]
              },
              "intuition": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/none"
                  },
                  {
                    "$ref": "#/$defs/short_intuition"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "archetype": {
            "const": "composer"
          }
        }
      },
      "then": {
        "properties": {
          "slots": {
            "properties": {
              "solves": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/none"
                  },
                  {
                    "required": [
                      "hero"
                    ],
                    "properties": {
                      "hero": {
                        "$ref": "#/$defs/hero_composer"
                      }
                    }
                  }
                ]
              },
              "quick_facts": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/none"
                  },
                  {
                    "$ref": "#/$defs/toy_facts"
                  }
                ]
              },
              "intuition": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/none"
                  },
                  {
                    "$ref": "#/$defs/short_intuition"
                  },
                  {
                    "$ref": "#/$defs/model_intuition"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "archetype": {
            "enum": [
              "hyperparameter",
              "output"
            ]
          }
        }
      },
      "then": {
        "required": [
          "applies_to"
        ]
      },
      "else": {
        "properties": {
          "applies_to": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "archetype": {
            "not": {
              "enum": [
                "hyperparameter",
                "output"
              ]
            }
          }
        }
      },
      "then": {
        "properties": {
          "targets": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "page_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "tag": {
      "type": "string",
      "pattern": "^(\\S+\\s+){0,4}\\S+$",
      "maxLength": 40
    },
    "one_line": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "none": {
      "type": "object",
      "properties": {
        "none": {
          "const": true
        }
      },
      "required": [
        "none"
      ],
      "additionalProperties": false
    },
    "dataset": {
      "enum": [
        "ames",
        "breast-cancer",
        "airline-passengers"
      ]
    },
    "setting_value": {
      "type": [
        "string",
        "number",
        "boolean"
      ]
    },
    "condition": {
      "type": "object",
      "properties": {
        "task_type": {
          "type": "array",
          "items": {
            "enum": [
              "regression",
              "classification"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "track": {
          "type": "array",
          "items": {
            "enum": [
              "standard",
              "time-series",
              "unsupervised",
              "causal",
              "deep-learning"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "has_categoricals": {
          "type": "boolean"
        },
        "has_missing": {
          "type": "boolean"
        },
        "time_ordered": {
          "type": "boolean"
        },
        "imbalanced": {
          "type": "boolean"
        }
      },
      "required": [],
      "additionalProperties": false,
      "minProperties": 1,
      "description": "Data-profile expression: every key must match (AND); list values match any member."
    },
    "prep_entry": {
      "type": "object",
      "properties": {
        "step": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "page": {
                  "$ref": "#/$defs/page_id"
