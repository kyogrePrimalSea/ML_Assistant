{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "taxonomy.schema.json",
  "title": "Taxonomy: goals, stages, groups, families, pages (QUESTION_MAP, spec 3.3)",
  "type": "object",
  "required": ["version", "source", "root", "goal_prompt", "goals", "later_goals", "stages"],
  "additionalProperties": false,
  "properties": {
    "version": {"const": 1},
    "source": {"type": "string", "minLength": 1},
    "root": {
      "type": "object",
      "required": ["question_prompt"],
      "additionalProperties": false,
      "properties": {"question_prompt": {"$ref": "#/$defs/text"}}
    },
    "goal_prompt": {"$ref": "#/$defs/text"},
    "goals": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "question_label", "names_label", "question_sentence", "track", "task"],
        "additionalProperties": false,
        "properties": {
          "id": {"$ref": "#/$defs/goal_id"},
          "question_label": {"$ref": "#/$defs/text"},
          "names_label": {"$ref": "#/$defs/text"},
          "question_sentence": {"$ref": "#/$defs/text"},
          "track": {"enum": ["standard", "time-series"]},
          "task": {"enum": ["regression", "classification"]}
        }
      }
    },
    "later_goals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "question_label", "names_label"],
        "additionalProperties": false,
        "properties": {
          "id": {"$ref": "#/$defs/slug"},
          "question_label": {"$ref": "#/$defs/text"},
          "names_label": {"$ref": "#/$defs/text"}
        }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "prefixItems": [
        {"$ref": "#/$defs/stage", "properties": {"id": {"const": "explore"}}},
        {"$ref": "#/$defs/stage", "properties": {"id": {"const": "clean"}}},
        {"$ref": "#/$defs/stage", "properties": {"id": {"const": "transform"}}},
        {"$ref": "#/$defs/stage", "properties": {"id": {"const": "select"}}},
        {"$ref": "#/$defs/stage", "properties": {"id": {"const": "split"}}},
        {"$ref": "#/$defs/stage", "properties": {"id": {"const": "model"}}},
        {"$ref": "#/$defs/stage", "properties": {"id": {"const": "tune"}}},
        {"$ref": "#/$defs/stage", "properties": {"id": {"const": "evaluate"}}},
        {"$ref": "#/$defs/stage", "properties": {"id": {"const": "interpret"}}}
      ],
      "items": false
    }
  },
  "$defs": {
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "goal_id": {"enum": ["predict-number", "predict-category", "forecast"]},
    "node_id": {"type": "string", "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+$"},
    "text": {"type": "string", "minLength": 1},
    "text_or_map": {
      "description": "One string for every goal, or a map from goal id to string.",
      "oneOf": [
        {"$ref": "#/$defs/text"},
        {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"$ref": "#/$defs/goal_id"},
          "additionalProperties": {"$ref": "#/$defs/text"}
        }
      ]
    },
    "text_or_map_or_null": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/text_or_map"}]
    },
    "for": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/goal_id"}
    },
    "page": {
      "type": "object",
      "required": ["id", "shown_as", "for", "pick_when"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/slug"},
        "shown_as": {"$ref": "#/$defs/text"},
        "for": {"$ref": "#/$defs/for"},
        "pick_when": {"$ref": "#/$defs/text"}
      }
    },
    "pages": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/page"}},
    "stage": {
      "type": "object",
      "required": ["id", "names_label", "question_label", "question_sentence", "question_prompt", "children"],
      "additionalProperties": false,
      "properties": {
        "id": {"enum": ["explore", "clean", "transform", "select", "split", "model", "tune", "evaluate", "interpret"]},
        "names_label": {"$ref": "#/$defs/text"},
        "question_label": {"$ref": "#/$defs/text_or_map"},
        "question_sentence": {"$ref": "#/$defs/text_or_map"},
        "question_prompt": {"$ref": "#/$defs/text_or_map"},
        "children": {
          "type": "array",
          "minItems": 1,
          "items": {"oneOf": [{"$ref": "#/$defs/group"}, {"$ref": "#/$defs/family"}]}
        }
      }
    },
    "group": {
      "description": "A group holds families (children) or pages directly, never both.",
      "type": "object",
      "required": ["id", "level", "names_label", "question_label", "question_sentence", "question_prompt", "for"],
      "oneOf": [{"required": ["children"]}, {"required": ["pages"]}],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/node_id"},
        "level": {"const": "group"},
        "names_label": {"$ref": "#/$defs/text"},
        "question_label": {"$ref": "#/$defs/text_or_map"},
        "question_sentence": {"$ref": "#/$defs/text_or_map"},
        "question_prompt": {"$ref": "#/$defs/text_or_map_or_null"},
        "for": {"$ref": "#/$defs/for"},
        "children": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/family"}},
        "pages": {"$ref": "#/$defs/pages"}
      }
    },
    "family": {
      "type": "object",
      "required": ["id", "level", "names_label", "question_label", "question_sentence", "question_prompt", "for", "pages"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/node_id"},
        "level": {"const": "family"},
        "names_label": {"$ref": "#/$defs/text"},
        "question_label": {"$ref": "#/$defs/text_or_map"},
        "question_sentence": {"$ref": "#/$defs/text_or_map"},
        "question_prompt": {"$ref": "#/$defs/text_or_map_or_null"},
        "for": {"$ref": "#/$defs/for"},
        "pages": {"$ref": "#/$defs/pages"}
      }
    }
  }
}
